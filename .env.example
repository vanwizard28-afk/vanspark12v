# ── Stripe checkout (gates the £7.99 PDF blueprint) ──────────────────────────
# Create a £7.99 one-off Price in the Stripe dashboard, then set both vars.
# Until these are present /api/checkout returns 503 and the button shows
# a 'checkout unavailable' error — the PDF only downloads after payment.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me

# Absolute site URL — used for OG image resolution and Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://vanspark.co.uk

# Google tag ID — GA4 (G-XXXXXXX) or Google Ads (AW-XXXXXXX).
# Loads gtag.js + enables conversion events (blueprint_click, share_build).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXX
